{$CADDY_SITE_ADDRESS} {
    root * /srv/frontend/dist
    encode gzip zstd

    handle /api/* {
        reverse_proxy backend:8000
    }

    @assets path /assets/*
    handle @assets {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    @app_html path /app /app/ /app/* /index.html
    handle @app_html {
        header {
            Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
            Pragma "no-cache"
            Expires "0"
        }
        try_files {path} /index.html
        file_server
    }

    handle {
        header {
            Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
            Pragma "no-cache"
            Expires "0"
        }
        try_files {path} /index.html
        file_server
    }
}
